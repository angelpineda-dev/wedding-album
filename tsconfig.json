{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [ 
      "src/**/*.ts",
      "src/**/*.d.ts",
      "scripts/**/*.ts",
      "test/**/*.ts",
      "vitest.config.ts",
    ]
}
