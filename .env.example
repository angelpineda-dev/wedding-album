# Copy this file to `.env` and replace the placeholders with real values.
# The app validates these at startup (src/config/env.ts) and refuses to start if one is invalid.

NODE_ENV=development
PORT=3000

# Connection string for PostgreSQL. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Access token (JWT, HS256) ---
# At least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=login-api
JWT_AUDIENCE=login-client
ACCESS_TOKEN_TTL_SECONDS=900

# --- Refresh token (opaque, stored hashed in the `sessions` table) ---
REFRESH_TOKEN_TTL_DAYS=7
# Secure flag on the refresh cookie. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# --- Login hardening ---
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the app (0 = none). Needed for real client IPs.
TRUST_PROXY=0
