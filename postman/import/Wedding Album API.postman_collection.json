                ]
              }
            }
          ]
        },
        {
          "name": "Reenviar invitación",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/clients/{{clientId}}/resend"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estadísticas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/stats"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Solo SUPER_ADMIN.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "03 Eventos cliente",
      "item": [
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events",
            "description": "Nace PENDING hasta que el superadmin lo habilite. Respeta la cuota del cliente (409 si se agotó). Guarda `eventId` y `eventCode`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana & Luis\",\n  \"opensAt\": \"{{opensAt}}\",\n  \"closesAt\": \"{{closesAt}}\",\n  \"timezone\": \"America/Mexico_City\",\n  \"venueName\": \"Hacienda San Gabriel\",\n  \"geofenceEnabled\": true,\n  \"latitude\": 20.6597,\n  \"longitude\": -103.3496,\n  \"radiusMeters\": 300,\n  \"moderationRequired\": true,\n  \"galleryPollSeconds\": 120\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ventana abierta desde hace 1 h hasta dentro de 5 h, para poder subir fotos ya.",
                  "const h = 3600 * 1000;",
                  "pm.variables.set('opensAt', new Date(Date.now() - h).toISOString());",
                  "pm.variables.set('closesAt', new Date(Date.now() + 5 * h).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('eventId', data.id);",
                  "pm.environment.set('eventCode', data.publicCode);",
                  "pm.test('nace PENDING', () => pm.expect(data.status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis eventos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/events/{{eventId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar evento",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events/{{eventId}}",
            "description": "Cualquier subconjunto de los campos de creación. Se valida contra lo ya guardado.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"galleryPollSeconds\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Eventos propios del cliente (rol USER).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{clientToken}}",
            "type": "string"
          }
        ]
      }
    },
