              }
            ],
            "url": "{{baseUrl}}/admin/clients/{{clientId}}",
            "description": "Cambia `eventQuota` y/o `status` (ACTIVE | SUSPENDED). Suspender revoca todas sus sesiones.",
            "body": {
              "mode": "raw",
