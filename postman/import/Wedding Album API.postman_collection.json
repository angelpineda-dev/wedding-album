          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/public/events/{{eventCode}}/gallery?limit=30",
            "description": "Solo PUBLISHED, más nuevo primero. `before=<nextCursor>` para páginas anteriores; `since=<latestCursor>` para el polling cada `pollSeconds`.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
