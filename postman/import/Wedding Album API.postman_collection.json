          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('aparece la foto aprobada', () => pm.expect(pm.response.json().data.items.map(i => i.id)).to.include(pm.environment.get('mediaId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ocultar",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/events/{{eventId}}/media/{{mediaId}}/hide"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Aprobar todas",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/events/{{eventId}}/media/approve-all"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cola global (superadmin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/moderation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Dueño del evento o SUPER_ADMIN (cambia el token a {{adminToken}} para probar como superadmin).",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{clientToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "08 Cierre",
      "item": [
        {
          "name": "Suspender evento",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/admin/events/{{eventId}}/suspend",
