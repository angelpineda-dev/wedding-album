          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Aprobar",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/events/{{eventId}}/media/{{mediaId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('publicada', () => pm.expect(pm.response.json().data.status).to.eql('PUBLISHED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Galería (polling)",
          "request": {
            "method": "GET",
            "header": [],
