        {
          "name": "Presencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/guest/presence",
            "description": "La posición no se guarda. Prueba con 20.2963, -103.1906 (≈43 km) para ver `inside: false`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 20.66,\n  \"longitude\": -103.35\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('puede subir', () => pm.expect(pm.response.json().data.canUpload).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "1 - Pedir URL de subida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/guest/media",
            "description": "Devuelve una URL PUT prefirmada (10 min). Content-Type y Content-Length van firmados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"PHOTO\",\n  \"mimeType\": \"image/jpeg\",\n  \"sizeBytes\": {{demoSize}},\n  \"latitude\": 20.66,\n  \"longitude\": -103.35\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Archivo de demo: el texto de 'Subir archivo'. El tamaño firmado debe coincidir con lo que se envía.",
                  "pm.variables.set('demoSize', String(new TextEncoder().encode(pm.environment.get('demoFileContent') || 'foto-de-prueba').length));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.environment.set('mediaId', data.media.id);",
                  "pm.environment.set('uploadUrl', data.upload.url);"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Subir archivo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/jpeg"
              }
            ],
            "url": "{{uploadUrl}}",
            "description": "PUT directo al bucket, SIN Authorization (la firma va en la URL). Para una foto real usa body \"binary\" y ajusta `sizeBytes` en el paso 1 al tamaño exacto del archivo.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{{demoFileContent}}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - Completar subida",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/guest/media/{{mediaId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('queda en moderación', () => pm.expect(pm.response.json().data.status).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis subidas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/guest/media/mine"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Flujo del invitado: galería pública (sin token), unirse con su nombre, presencia y subida en 3 pasos.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{guestToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "07 Moderacion",
      "item": [
        {
          "name": "Pendientes",
          "request": {
            "method": "GET",
            "header": [],
