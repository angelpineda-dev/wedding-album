      ],
      "description": "Pasos que dejan el evento fuera de servicio. Van al final a propósito.",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
