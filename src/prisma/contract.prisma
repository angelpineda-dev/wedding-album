// use prisma-8
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum EventType {
  WEDDING
}

// PENDING until a SUPER_ADMIN confirms the paid package; only ENABLED events accept guests.
enum EventStatus {
  PENDING
  ENABLED
  SUSPENDED
}

enum MediaKind {
  PHOTO
  VIDEO
}

// UPLOADING: URL issued, file not confirmed. PENDING: waiting for moderation.
// PUBLISHED: in the gallery. HIDDEN: rejected or taken down by a moderator.
enum MediaStatus {
  UPLOADING
  PENDING
  PUBLISHED
  HIDDEN
}

// Suspended users cannot sign in; suspending also revokes every session.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  name                String             
  lastName            String?
  // Null for clients (role USER): they sign in with a magic link.
  password            String?
  role                Role               @default(USER)
  status              UserStatus         @default(ACTIVE)
  // How many events a client may create.
  eventQuota          Int                @default(1)
  // Bumped on logout-all / refresh-token reuse: invalidates every access token issued before.
  tokenVersion        Int                @default(0)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now()) @onCreate(now())
  updatedAt           DateTime           @default(now()) @onUpdate(now())
  deletedAt           DateTime?
  sessions            Session[]
  magicLinks          MagicLink[]
  events              Event[]
  moderatedMedia      Media[]
  
  @@map("users")          
}

// One row per refresh token. Only the SHA-256 of the token is stored.
// Rotation revokes the row and creates a new one with the same familyId.
model Session {
  id        String    @id @onCreate(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId])
  @@map("sessions")
}

// One-time sign-in link for clients. Only the SHA-256 of the token is stored.
model MagicLink {
  id        String    @id @onCreate(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId])
  @@map("magic_links")
}

// A client's event (album). Guests reach it through `publicCode` (the QR).
model Event {
  id                 String      @id @onCreate(uuid())
  ownerId            Int
  owner              User        @relation(fields: [ownerId], references: [id])
  type               EventType   @default(WEDDING)
  name               String
  // Upload window; the event's date is the day `opensAt` falls on in `timezone`.
  opensAt            DateTime
  closesAt           DateTime
  timezone           String
  venueName          String?
  geofenceEnabled    Boolean     @default(false)
  latitude           Float?
  longitude          Float?
  // Geofence radius in metres, 100–1000 (RADIUS_METERS in src/core/const/event.ts).
  radiusMeters       Int         @default(300)
  moderationRequired Boolean     @default(true)
  // How often guests' galleries poll for new media.
  galleryPollSeconds Int         @default(120)
  status             EventStatus @default(PENDING)
  // Paid package (multiple of 25 guests); null until enabled. Guest limit = packageMax + 5.
  packageMax         Int?
  publicCode         String      @unique
  enabledAt          DateTime?
  createdAt          DateTime    @default(now()) @onCreate(now())
  updatedAt          DateTime    @default(now()) @onUpdate(now())
  guests             Guest[]
  media              Media[]

  @@index([ownerId])
  @@index([status])
  @@map("events")
}

// Someone who joined an event from its QR with just a name. No account: the opaque
// token returned on join (stored hashed) identifies them until `expiresAt`.
model Guest {
  id         String    @id @onCreate(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now()) @onCreate(now())
  media      Media[]

  @@index([eventId])
  @@map("guests")
}

// A photo or video a guest uploaded. The file lives in object storage under `storageKey`.
model Media {
  id            String      @id @onCreate(uuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId       String
  guest         Guest       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  kind          MediaKind
  status        MediaStatus @default(UPLOADING)
  storageKey    String      @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime    @default(now()) @onCreate(now())
  uploadedAt    DateTime?
  publishedAt   DateTime?
  moderatedById Int?
  moderatedBy   User?       @relation(fields: [moderatedById], references: [id])

  @@index([eventId, status])
  @@index([guestId])
  @@map("media")
}
