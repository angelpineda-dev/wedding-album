// use prisma-8
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum EventType {
  WEDDING
}

// PENDING until a SUPER_ADMIN confirms the paid package; only ENABLED events accept guests.
enum EventStatus {
  PENDING
  ENABLED
  SUSPENDED
}

// Suspended users cannot sign in; suspending also revokes every session.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  name                String             
  lastName            String?
  // Null for clients (role USER): they sign in with a magic link.
  password            String?
  role                Role               @default(USER)
  status              UserStatus         @default(ACTIVE)
  // How many events a client may create.
  eventQuota          Int                @default(1)
  // Bumped on logout-all / refresh-token reuse: invalidates every access token issued before.
  tokenVersion        Int                @default(0)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now()) @onCreate(now())
  updatedAt           DateTime           @default(now()) @onUpdate(now())
  deletedAt           DateTime?
  sessions            Session[]
  magicLinks          MagicLink[]
  events              Event[]
  
  @@map("users")          
}

// One row per refresh token. Only the SHA-256 of the token is stored.
// Rotation revokes the row and creates a new one with the same familyId.
model Session {
  id        String    @id @onCreate(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId])
  @@map("sessions")
}

// One-time sign-in link for clients. Only the SHA-256 of the token is stored.
model MagicLink {
  id        String    @id @onCreate(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId])
  @@map("magic_links")
}

// A client's event (album). Guests reach it through `publicCode` (the QR).
model Event {
  id                 String      @id @onCreate(uuid())
  ownerId            Int
  owner              User        @relation(fields: [ownerId], references: [id])
  type               EventType   @default(WEDDING)
  name               String
  // Upload window; the event's date is the day `opensAt` falls on in `timezone`.
  opensAt            DateTime
  closesAt           DateTime
  timezone           String
  venueName          String?
  geofenceEnabled    Boolean     @default(false)
  latitude           Float?
  longitude          Float?
  radiusMeters       Int         @default(5000)
  moderationRequired Boolean     @default(true)
  // How often guests' galleries poll for new media.
  galleryPollSeconds Int         @default(120)
  status             EventStatus @default(PENDING)
  // Paid package (multiple of 25 guests); null until enabled. Guest limit = packageMax + 5.
  packageMax         Int?
  publicCode         String      @unique
  enabledAt          DateTime?
  createdAt          DateTime    @default(now()) @onCreate(now())
  updatedAt          DateTime    @default(now()) @onUpdate(now())

  @@index([ownerId])
  @@index([status])
  @@map("events")
}
