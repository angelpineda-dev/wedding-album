// use prisma-8
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  name                String             
  lastName            String?
  password            String
  role                Role               @default(USER)
  // Bumped on logout-all / refresh-token reuse: invalidates every access token issued before.
  tokenVersion        Int                @default(0)
  failedLoginAttempts Int                @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime           @default(now()) @onCreate(now())
  updatedAt           DateTime           @default(now()) @onUpdate(now())
  deletedAt           DateTime?
  sessions            Session[]
  
  @@map("users")          
}

// One row per refresh token. Only the SHA-256 of the token is stored.
// Rotation revokes the row and creates a new one with the same familyId.
model Session {
  id        String    @id @onCreate(uuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @onCreate(now())

  @@index([userId])
  @@map("sessions")
}
